<Page
    x:Class="DiskGuardian.UI.Views.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="审计流水与日志" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="每一次扫描、发现与清理动作均严格落盘记录，提供全流程可溯源凭证" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <TextBox x:Name="LogTextBox" Grid.Row="1"
                 IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas, Cascadia Code, Courier New"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Page>
