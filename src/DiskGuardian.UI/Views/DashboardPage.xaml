<Page
    x:Class="DiskGuardian.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="0,0,16,24">
            <!-- 头部 -->
            <StackPanel Spacing="4">
                <TextBlock Text="系统状态总览" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="基于真实排障证据驱动，坚决不误杀事件日志与系统核心依赖" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 25H2 观察期与禁区指示卡片 -->
            <InfoBar Title="25H2 蓝屏观察期防护生效中" 
                     Message="已锁定 winevt 事件日志、崩溃转储 (dmp) 与专用转储文件 (dedicateddumpfile.sys)，硬禁区代码化自测 100% PASS。" 
                     IsOpen="True" Severity="Success" IsClosable="False"/>

            <!-- 系统网络与幽灵代理体检卡片 (ProxyDoctor) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16">
                <StackPanel Spacing="16">
                    <!-- 顶部状态栏与操作按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="ProxyStatusIcon" Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="网络与幽灵代理体检 (ProxyDoctor)" FontWeight="SemiBold" FontSize="16"/>
                                <Border x:Name="ProxyStatusBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock x:Name="ProxyBadgeText" Text="检测中..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ProxySummaryText" Text="正在全面排查 WinINET 注册表、底层标志位与回环端口..." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="加固 Agent IDE 代理" Click="HardenIdeProxy_Click"/>
                            <Button Content="创建桌面快捷方式" Click="CreateShortcut_Click"/>
                            <Button Content="重新体检" Click="RefreshProxy_Click"/>
                            <Button x:Name="FixProxyButton" Content="一键安全修复" Click="FixProxy_Click" 
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 宫格核心配置指标面板 (Metric Tiles) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tile 1: 工作模式 -->
                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="代理工作模式" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProxyModeValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProxyModeSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 2: 目标服务器与端口 -->
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="服务器与端口" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProxyEndpointValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProxyEndpointSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 3: 本地端口连通性 -->
                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="本地端口状态" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProxyPortHealthValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProxyPortHealthSubText" Text="探测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 4: WinINET 二进制标志位 -->
                        <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="WinINET 标志位" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProxyFlagsValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProxyFlagsSubText" Text="解析中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 底层技术排查与取证折叠面板 (Expander) -->
                    <Expander Header="查看网络与环境底层取证细节" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8" Padding="4,8">
                            <Grid ColumnSpacing="16" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="注册表 DWORD (ProxyEnable):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailProxyEnableText" Grid.Row="0" Grid.Column="1" Text="--" FontSize="12" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="绕过列表 (ProxyOverride):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailProxyOverrideText" Grid.Row="1" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="自动配置脚本 (PAC):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailPacText" Grid.Row="2" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="用户环境变量 (HTTP_PROXY):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailEnvProxyText" Grid.Row="3" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Git 全局代理 (http.proxy):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailGitProxyText" Grid.Row="4" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" x:Name="DetailAppHardeningLabel" Text="已识别应用安全隔离:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailAppHardeningText" Grid.Row="5" Grid.Column="1" Text="--" FontSize="12"/>
                            </Grid>

                            <TextBlock Text="已识别 Agent IDE 代理防线 (VS Code / Cursor / WorkBuddy 等):" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBlock x:Name="DetailIdeListText" Text="检测中..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                            <TextBlock Text="取证分析日志:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ProxyDetailLogsText" Text="无异常日志" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 磁盘容量卡片组 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- C 盘卡片 -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="系统盘 (C:)" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <ProgressBar x:Name="CProgress" Height="8" Value="88"/>
                        <TextBlock x:Name="CText" Text="可用: 34.60 GiB / 300.00 GiB (已用 88%)" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- D 盘卡片 -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="数据与代码盘 (D:)" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <ProgressBar x:Name="DProgress" Height="8" Value="96" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="DText" Text="可用: 38.2 GiB / 953 GiB (极度紧张，~34 GiB 构建产物可释放)" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 差异化能力亮点 -->
            <TextBlock Text="核心守护亮点" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="20" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="现代开发链专治" FontWeight="SemiBold"/>
                        <TextBlock Text="自动探测 Rust target、前端 node_modules，Dism++ 在此完全为 0 命中。" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE81D;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock Text="防误杀死锁" FontWeight="SemiBold"/>
                        <TextBlock Text="同级清单匹配 + 严格排除 Electron 运行时，绝不误触常用软件。" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="20" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="可撤销两步删除" FontWeight="SemiBold"/>
                        <TextBlock Text="清理默认移入回收站，单独确认才清空，告别粗暴的永久物理删除。" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>