<Page
    x:Class="DiskGuardian.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="0,0,16,24">
            <!-- 头部 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="系统状态总览" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="基于真实排障证据驱动，坚决不误杀事件日志与系统核心依赖" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="FullScanBtn" Grid.Column="1" Content="🚀 一键全盘体检" Style="{ThemeResource AccentButtonStyle}"
                        VerticalAlignment="Center" Click="FullScan_Click"
                        ToolTipService.ToolTip="并发刷新磁盘水位、网络代理、外壳截图、浏览器显存与硬件风暴诊断"/>
            </Grid>

            <!-- 25H2 观察期与禁区指示卡片 -->
            <InfoBar Title="25H2 蓝屏观察期防护生效中" 
                     Message="已锁定 winevt 事件日志、崩溃转储 (dmp) 与专用转储文件 (dedicateddumpfile.sys)，硬禁区代码化自测 100% PASS。" 
                     IsOpen="True" Severity="Success" IsClosable="False"/>

            <!-- 系统网络与幽灵代理体检卡片 (ProxyDoctor) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16">
                <StackPanel Spacing="16">
                    <!-- 顶部状态栏与操作按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="ProxyStatusIcon" Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="网络与幽灵代理体检 (ProxyDoctor)" FontWeight="SemiBold" FontSize="16"/>
                                <Border x:Name="ProxyStatusBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock x:Name="ProxyBadgeText" Text="检测中..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ProxySummaryText" Text="正在全面排查 WinINET 注册表、底层标志位与回环端口..." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="加固 IDE 代理" Click="HardenIdeProxy_Click"/>
                            <Button Content="创建桌面快捷方式" Click="CreateShortcut_Click"/>
                            <Button Content="重新体检" Click="RefreshProxy_Click"/>
                            <Button x:Name="PureDirectButton" Content="🎮 切回纯净直连 (游戏模式)" Click="PureDirect_Click"/>
                            <Button x:Name="FixProxyButton" Content="一键安全修复" Click="FixProxy_Click" 
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 宫格核心配置指标面板 (Metric Tiles) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tile 1: 工作模式 -->
                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="代理工作模式" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProxyModeValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProxyModeSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 2: 目标服务器与端口 -->
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="服务器与端口" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProxyEndpointValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProxyEndpointSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 3: 本地端口连通性 -->
                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="本地端口状态" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProxyPortHealthValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProxyPortHealthSubText" Text="探测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 4: WinINET 二进制标志位 -->
                        <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="WinINET 标志位" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ProxyFlagsValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProxyFlagsSubText" Text="解析中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 底层技术排查与取证折叠面板 (Expander) -->
                    <Expander Header="查看网络与环境底层取证细节" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8" Padding="4,8">
                            <Grid ColumnSpacing="16" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="注册表 DWORD (ProxyEnable):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailProxyEnableText" Grid.Row="0" Grid.Column="1" Text="--" FontSize="12" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="绕过列表 (ProxyOverride):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailProxyOverrideText" Grid.Row="1" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="自动配置脚本 (PAC):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailPacText" Grid.Row="2" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="用户环境变量 (HTTP_PROXY):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailEnvProxyText" Grid.Row="3" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Git 全局代理 (http.proxy):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailGitProxyText" Grid.Row="4" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" x:Name="DetailAppHardeningLabel" Text="已识别应用安全隔离:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailAppHardeningText" Grid.Row="5" Grid.Column="1" Text="--" FontSize="12"/>
                            </Grid>

                            <TextBlock Text="已识别 Agent IDE 代理防线 (VS Code / Cursor / WorkBuddy 等):" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBlock x:Name="DetailIdeListText" Text="检测中..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                            <TextBlock Text="后台常驻代理软件与系统服务 (FlClash / Clash Verge 等):" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBlock x:Name="DetailRunningClientsText" Text="无常驻进程" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                            <TextBlock Text="取证分析日志:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ProxyDetailLogsText" Text="无异常日志" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 系统外壳与资源管理器体检卡片 (ExplorerDoctor) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16">
                <StackPanel Spacing="16">
                    <!-- 顶部状态栏与操作按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="ExplorerStatusIcon" Glyph="&#xED25;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="桌面外壳与资源管理器体检 (ExplorerDoctor)" FontWeight="SemiBold" FontSize="16"/>
                                <Border x:Name="ExplorerStatusBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock x:Name="ExplorerBadgeText" Text="检测中..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ExplorerSummaryText" Text="正在探测 Windows 11 现代 Fluent 命令栏、多标签页架构与进程配置..." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="重新体检" Click="RefreshExplorer_Click"/>
                            <Button Content="⚡ 一键重置截图" Click="ResetSnipping_Click" 
                                    ToolTipService.ToolTip="清理后台堆积的 SnippingTool 僵死进程，释放剪贴板与屏幕捕获锁，秒解快捷键截图卡死"/>
                            <Button x:Name="FixExplorerButton" Content="一键恢复 Win11 原生" Click="FixExplorer_Click" 
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 宫格核心配置指标面板 (Metric Tiles) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tile 1: 外壳架构体系 -->
                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="外壳架构体系" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ExplorerArchValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ExplorerArchSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 2: 现代命令栏阻断 -->
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="现代 Fluent 命令栏" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ExplorerBlockedValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ExplorerBlockedSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 3: 窗口进程隔离策略 -->
                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="独立进程策略" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ExplorerSeparateProcessValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ExplorerSeparateProcessSubText" Text="探测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 4: 快捷截图通道 (Win+Shift+S) -->
                        <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="快捷截图通道 (Win+Shift+S)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ExplorerSnippingValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ExplorerSnippingSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 底层技术排查与取证折叠面板 (Expander) -->
                    <Expander Header="查看外壳配置与排障取证细节" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8" Padding="4,8">
                            <Grid ColumnSpacing="16" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows 内核版本:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailExplorerSysVerText" Grid.Row="0" Grid.Column="1" Text="--" FontSize="12" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="现代外壳 CLSID 状态:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailExplorerClsidText" Grid.Row="1" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="独立进程配置 (SeparateProcess):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailExplorerSepProcText" Grid.Row="2" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="当前会话运行权限:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailExplorerIntegrityText" Grid.Row="3" Grid.Column="1" Text="--" FontSize="12"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="快捷截图工具运行状态:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DetailExplorerSnippingText" Grid.Row="4" Grid.Column="1" Text="--" FontSize="12"/>
                            </Grid>

                            <TextBlock Text="取证分析日志与修复建议:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ExplorerDetailLogsText" Text="无异常日志" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 浏览器性能与显存体检卡片 (BrowserDoctor) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <!-- 顶层卡片 Header -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="BrowserStatusIcon" Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="浏览器性能与显存医生 (BrowserDoctor)" FontWeight="SemiBold" FontSize="16"/>
                                <Border x:Name="BrowserStatusBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock x:Name="BrowserBadgeText" Text="检测中..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="BrowserSummaryText" Text="正在探测 Chromium 浏览器进程树、GPU 渲染通道与显存开销..." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="重新体检" Click="RefreshBrowser_Click"/>
                            <Button x:Name="ReleaseGpuButton" Content="⚡ 释放 GPU 显存" Click="ReleaseGpu_Click" 
                                    Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="秒级安全重启 GPU 渲染通道（零网页丢失、不关窗口，瞬间释放显存与掉帧卡顿）"/>
                            <Button x:Name="TrimBrowserButton" Content="🧹 压缩闲置内存" Click="TrimBrowser_Click" 
                                    ToolTipService.ToolTip="修剪闲置内存碎片，立即降低物理内存占用"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 宫格核心配置指标面板 (Metric Tiles) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tile 1: 运行实例 -->
                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="运行实例" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="BrowserInstanceValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="BrowserInstanceSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 2: 内存总开销 -->
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="总物理内存" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="BrowserMemValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="BrowserMemSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 3: GPU 显存渲染通道 -->
                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="GPU 显存通道" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="BrowserGpuValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="BrowserGpuSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 4: 性能健康评级 -->
                        <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="性能健康评级" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="BrowserHealthValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="BrowserHealthSubText" Text="评估中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 底层技术排查与取证折叠面板 (Expander) -->
                    <Expander Header="查看子进程分布与内存大户 Top 8" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8" Padding="4,8">
                            <TextBlock Text="内存占用最高的前 8 个子进程明细:" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BrowserDetailProcessesText" Text="无数据" 
                                       FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="诊断与优化日志:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="BrowserDetailLogsText" Text="等待体检" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 硬件掉线与输入卡顿体检卡片 (DeviceDoctor) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <!-- 顶层卡片 Header -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="DeviceStatusIcon" Glyph="&#xE702;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="硬件重连风暴与输入卡顿医生 (DeviceDoctor)" FontWeight="SemiBold" FontSize="16"/>
                                <Border x:Name="DeviceStatusBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock x:Name="DeviceBadgeText" Text="检测中..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DeviceSummaryText" Text="正在扫描近 15 分钟 BTHUSB / USB 掉线风暴、PnP 错误码与桌面输入宿主..." 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="重新体检" Click="RefreshDevice_Click"/>
                            <Button x:Name="ResetInputButton" Content="🔄 刷新菜单与输入法" Click="ResetInputHosts_Click"
                                    ToolTipService.ToolTip="安全刷新开始菜单/搜索/输入法宿主进程（绝不触碰 explorer.exe），秒恢复 Win 键与回车响应"/>
                            <Button x:Name="DisableErrorDevicesButton" Content="🧹 禁用异常虚拟设备" Click="DisableErrorDevices_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="批量禁用存在健康同类兄弟节点且报 Code 10 的重复虚拟设备（如冗余虚拟声卡节点）"/>
                            <Button x:Name="DisableBthButton" Content="⚡ 止损异常蓝牙" Click="DisableStormBluetooth_Click"
                                    Style="{ThemeResource AccentButtonStyle}" IsEnabled="False"
                                    ToolTipService.ToolTip="检测到 BTHUSB 掉线重连风暴时，临时禁用异常蓝牙适配器止住系统卡死"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 宫格核心配置指标面板 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="硬件重连风暴 (15m)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DeviceStormValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DeviceStormSubText" Text="扫描中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="蓝牙适配器状态" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DeviceBthValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DeviceBthSubText" Text="扫描中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="输入与菜单宿主" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DeviceInputValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DeviceInputSubText" Text="扫描中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="PnP 设备健康度" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DeviceHealthValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DeviceHealthSubText" Text="评估中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 底层事件与设备取证折叠面板 -->
                    <Expander Header="查看系统事件风暴与输入宿主明细" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8" Padding="4,8">
                            <TextBlock Text="桌面输入与开始菜单宿主状态:" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DeviceInputDetailsText" Text="等待扫描"
                                       FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="硬件掉线 / PnP 异常取证日志:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock x:Name="DeviceEventDetailsText" Text="无异常"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 电源调度与温控偏好体检卡片 (PowerDoctor) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="PowerStatusIcon" Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="电源调度与温控偏好医生 (PowerDoctor)" FontWeight="SemiBold" FontSize="16"/>
                                <Border x:Name="PowerStatusBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock x:Name="PowerBadgeText" Text="检测中..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="PowerSummaryText" Text="正在排查活动电源方案的 PERFEPP 能源偏好、核心休止与睿频调度..."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="重新体检" Click="RefreshPower_Click"/>
                            <Button x:Name="RestorePowerButton" Content="恢复默认偏好" Click="RestorePower_Click"/>
                            <Button x:Name="OptimizePowerButton" Content="🌡️ 温和降温调优" Click="OptimizePower_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="免管理员将插电 PERFEPP 设为 45%、PERFEPP1 设为 50%，降低轻载高温而不限制满载性能"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="活动电源方案" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="PowerSchemeValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PowerSchemeSubText" Text="检测中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="性能核偏好 (PERFEPP)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="PowerEppValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PowerEppSubText" Text="数值越高越注重节能降温" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="能效核偏好 (PERFEPP1)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="PowerEpp1ValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PowerEpp1SubText" Text="轻载后台调度偏好" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="核心休止与增强策略" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="PowerCoreValueText" Text="--" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PowerCoreSubText" Text="评估中" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Expander Header="查看电源策略参数与控制中心联动明细" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="PowerDetailLogsText" Text="等待检测"
                                   FontFamily="Consolas, Segoe UI" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="11" TextWrapping="Wrap" Padding="4,8"/>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 磁盘容量卡片组 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- C 盘卡片 -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="系统盘 (C:)" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <ProgressBar x:Name="CProgress" Height="8" Value="88"/>
                        <TextBlock x:Name="CText" Text="可用: 34.60 GiB / 300.00 GiB (已用 88%)" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- D 盘卡片 -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="数据与代码盘 (D:)" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <ProgressBar x:Name="DProgress" Height="8" Value="96" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="DText" Text="可用: 38.2 GiB / 953 GiB (极度紧张，~34 GiB 构建产物可释放)" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 差异化能力亮点 -->
            <TextBlock Text="核心守护亮点" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="20" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="现代开发链专治" FontWeight="SemiBold"/>
                        <TextBlock Text="自动探测 Rust target、前端 node_modules，Dism++ 在此完全为 0 命中。" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE81D;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock Text="防误杀死锁" FontWeight="SemiBold"/>
                        <TextBlock Text="同级清单匹配 + 严格排除 Electron 运行时，绝不误触常用软件。" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="20" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="可撤销两步删除" FontWeight="SemiBold"/>
                        <TextBlock Text="清理默认移入回收站，单独确认才清空，告别粗暴的永久物理删除。" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SystemTools 常用工具快捷入口 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="常用系统工具箱 (SystemTools 整合)" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="统一收拢日常维护独立工具，只读直达不跑丢" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="💬 微信文件归集" Tag="wechat" Click="LaunchSystemTool_Click"/>
                        <Button Content="🔐 2FA 本地验证码" Tag="2fa" Click="LaunchSystemTool_Click"/>
                        <Button Content="⚡ WinTuner 调校" Tag="wintuner" Click="LaunchSystemTool_Click"/>
                        <Button Content="📂 打开工具目录" Tag="folder" Click="LaunchSystemTool_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>