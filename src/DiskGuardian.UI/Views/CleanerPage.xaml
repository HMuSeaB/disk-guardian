<Page
    x:Class="DiskGuardian.UI.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="空间规则清理" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="按需选择规则精准扫描，拒绝全盘强制卡顿；所有清理动作均先安全移入回收站" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 选项预设与扫描控制栏 -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：级别筛选与快捷预设 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="预设级别:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                    <ComboBox x:Name="LevelCombo" SelectedIndex="0" SelectionChanged="LevelCombo_SelectionChanged" Width="135">
                        <ComboBoxItem Content="Level 1 (常规)"/>
                        <ComboBoxItem Content="Level 2 (推荐)"/>
                        <ComboBoxItem Content="Level 3 (完整)"/>
                    </ComboBox>

                    <Button Content="仅L1" Click="SelectL1_Click" Padding="10,5"/>
                    <Button Content="全选" Click="SelectAll_Click" Padding="10,5"/>
                    <Button Content="清空" Click="DeselectAll_Click" Padding="10,5"/>
                </StackPanel>

                <!-- 中间：自适应状态提示（自动弹性伸缩与字符省略，绝不挤压右侧按钮） -->
                <TextBlock Grid.Column="1" x:Name="ScanStatusText" 
                           Text="已就绪，请勾选需要扫描的项" 
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxLines="1" Margin="4,0,8,0"/>

                <!-- 右侧：最高优先级触发按钮与进度环（固定靠右锁定，任何宽度下永远完整可见） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="ScanRing" IsActive="False" Width="18" Height="18"/>
                    <Button x:Name="ScanButton" Content="开始扫描勾选项" Click="ScanButton_Click" 
                            Style="{ThemeResource AccentButtonStyle}" Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 规则清单列表 -->
        <ListView x:Name="RulesList" Grid.Row="2"
                  SelectionMode="None"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="14,12" Spacing="8">
                        <!-- 顶层主行卡片 -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 选择勾选框 -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                      VerticalAlignment="Center"/>

                            <!-- 规则详情 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding LevelDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding TypeBadge}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding SizeHint}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Rebuild}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>

                                <!-- 多项目展开控制入口 -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{Binding SubItemsVisibility}" Margin="0,4,0,0">
                                    <HyperlinkButton Padding="0" Click="ToggleExpand_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="{Binding ExpandIconGlyph}" FontSize="11"/>
                                            <TextBlock Text="{Binding ExpandActionText}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <TextBlock Text="{Binding SubItemsSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 容量与扫描状态 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4" MinWidth="110">
                                <TextBlock Text="{Binding SizeDisplay}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" HorizontalAlignment="Right" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 子项目明细列表 (展开时展示) -->
                        <Border Visibility="{Binding ExpandedVisibility}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="36,4,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="已发现项目明细 (取消勾选即可保留对应项目 target/依赖，免除重复编译或重装):" 
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding SubItemRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeHuman}" FontWeight="SemiBold" FontSize="12" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                                <Button Grid.Column="3" Content="定位" Padding="8,2" FontSize="11" 
                                                        Click="OpenFolder_Click" Tag="{Binding Path}" ToolTipService.ToolTip="在文件资源管理器中打开此目录"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部汇总与执行操作栏 -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="已扫描勾选可释放:" FontSize="14"/>
                        <TextBlock x:Name="TotalSizeText" Text="0 B" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock x:Name="TotalFilesText" Text="" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="临时缓存建议【直接永久清理】（极速且不塞爆回收站）；代码依赖推荐【移入回收站】" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="ApplyRecycleButton" Content="移入回收站 (可撤销)" 
                            Click="ApplyRecycleButton_Click" Padding="14,10"/>
                    <Button x:Name="ApplyPermanentButton" Content="直接永久清理 (极速模式)" 
                            Click="ApplyPermanentButton_Click" Style="{ThemeResource AccentButtonStyle}" Padding="16,10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
