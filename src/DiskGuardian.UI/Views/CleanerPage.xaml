<Page
    x:Class="DiskGuardian.UI.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="空间规则清理" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="按需选择规则精准扫描，拒绝全盘强制卡顿；所有清理动作均先安全移入回收站" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 选项预设与扫描控制栏 -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：级别筛选与快捷预设 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="预设级别:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="LevelCombo" SelectedIndex="0" SelectionChanged="LevelCombo_SelectionChanged" Width="140">
                            <ComboBoxItem Content="Level 1 (常规)"/>
                            <ComboBoxItem Content="Level 2 (推荐)"/>
                            <ComboBoxItem Content="Level 3 (完整)"/>
                        </ComboBox>

                        <Button Content="仅L1快速" Click="SelectL1_Click"/>
                        <Button Content="全选" Click="SelectAll_Click"/>
                        <Button Content="清空" Click="DeselectAll_Click"/>
                    </StackPanel>

                    <!-- 右侧：扫描状态指示与显式扫描触发按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing x:Name="ScanRing" IsActive="False" Width="20" Height="20"/>
                        <TextBlock x:Name="ScanStatusText" Text="已就绪，请勾选需要扫描的项" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <Button x:Name="ScanButton" Content="开始扫描勾选项" Click="ScanButton_Click" 
                                Style="{ThemeResource AccentButtonStyle}" Padding="16,6"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 规则清单列表 -->
        <ListView x:Name="RulesList" Grid.Row="2"
                  SelectionMode="None"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="14,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 选择勾选框 -->
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                  VerticalAlignment="Center"/>

                        <!-- 规则详情 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding LevelDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding TypeBadge}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding SizeHint}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Rebuild}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <!-- 容量与扫描状态 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding SizeDisplay}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" HorizontalAlignment="Right" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部汇总与执行操作栏 -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="已扫描勾选可释放:" FontSize="14"/>
                        <TextBlock x:Name="TotalSizeText" Text="0 B" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                    </StackPanel>
                    <TextBlock Text="点击【移入回收站】将仅处理已扫描且有可释放体积的勾选项（安全可撤销）" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Button x:Name="ApplyButton" Grid.Column="1" Content="移入回收站 (安全清理)" 
                        Click="ApplyButton_Click" Style="{ThemeResource AccentButtonStyle}" Padding="20,10"/>
            </Grid>
        </Border>
    </Grid>
</Page>
