<Page
    x:Class="DiskGuardian.UI.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="空间规则清理" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="按需选择规则精准扫描，拒绝全盘强制卡顿；所有清理动作均先安全移入回收站" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 选项预设、分类导航与扫描控制栏 -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <StackPanel Spacing="10">
                <!-- 第一行：分类导航标签与即时搜索框（彻底移除 ScrollViewer，杜绝滑动条遮挡） -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 分类标签按钮组（自然平铺，完全无需横向滚动条） -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="TabAll" Content="🌟 全部" Click="CategoryTab_Click" Tag="all" Style="{ThemeResource AccentButtonStyle}" Padding="8,5" FontSize="12"/>
                        <Button x:Name="TabDev" Content="💻 开发" Click="CategoryTab_Click" Tag="dev" Padding="8,5" FontSize="12"/>
                        <Button x:Name="TabGaming" Content="🎮 游戏" Click="CategoryTab_Click" Tag="gaming" Padding="8,5" FontSize="12"/>
                        <Button x:Name="TabApp" Content="💬 软件" Click="CategoryTab_Click" Tag="app" Padding="8,5" FontSize="12"/>
                        <Button x:Name="TabSystem" Content="🪟 系统" Click="CategoryTab_Click" Tag="system" Padding="8,5" FontSize="12"/>
                        <Button x:Name="TabContainer" Content="🐳 容器" Click="CategoryTab_Click" Tag="container" Padding="8,5" FontSize="12"/>
                    </StackPanel>

                    <!-- 搜索框 -->
                    <TextBox Grid.Column="1" x:Name="SearchBox" 
                             PlaceholderText="🔍 实时搜索规则..." 
                             TextChanged="SearchBox_TextChanged" Width="190"
                             VerticalAlignment="Center" FontSize="12"/>
                </Grid>

                <!-- 第二行：勾选操作工具栏 + 动态状态提示 + 扫描触发 -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 快捷勾选控制矩阵 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="仅选L1(推荐)" Click="SelectL1_Click" Padding="10,5" ToolTipService.ToolTip="仅勾选 Level 1 安全纯缓存项"/>
                        <Button Content="全选当前" Click="SelectCurrentView_Click" Padding="10,5" ToolTipService.ToolTip="全选当前分类或搜索视图下的所有规则"/>
                        <Button Content="反选" Click="InvertSelection_Click" Padding="10,5" ToolTipService.ToolTip="反转当前视图下所有项的勾选状态"/>
                        <Button Content="清空选择" Click="DeselectAll_Click" Padding="10,5" ToolTipService.ToolTip="取消所有已勾选项，便于单选"/>
                    </StackPanel>

                    <!-- 中间：自适应状态提示 -->
                    <TextBlock Grid.Column="1" x:Name="ScanStatusText" 
                               Text="已就绪，请勾选需要扫描的项" 
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Margin="4,0,8,0"/>

                    <!-- 右侧：扫描按钮与环 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="ScanRing" IsActive="False" Width="18" Height="18"/>
                        <Button x:Name="ScanButton" Content="开始扫描勾选项" Click="ScanButton_Click" 
                                Style="{ThemeResource AccentButtonStyle}" Padding="14,6"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 规则清单列表 -->
        <ListView x:Name="RulesList" Grid.Row="2"
                  SelectionMode="None"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="14,12" Spacing="8">
                        <!-- 顶层主行卡片 -->
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 选择勾选框 -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                      VerticalAlignment="Center"/>

                            <!-- 规则详情 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    
                                    <!-- 智能分类标签 -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding CategoryBadge}" FontSize="11" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                    </Border>

                                    <!-- 级别徽章 -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding LevelDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    
                                    <!-- 类型徽章 -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding TypeBadge}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    </Border>

                                    <TextBlock Text="{Binding SizeHint}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Rebuild}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>

                                <!-- 多项目展开控制入口 -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{Binding SubItemsVisibility}" Margin="0,4,0,0">
                                    <HyperlinkButton Padding="0" Click="ToggleExpand_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="{Binding ExpandIconGlyph}" FontSize="11"/>
                                            <TextBlock Text="{Binding ExpandActionText}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <TextBlock Text="{Binding SubItemsSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 右侧操作与状态区 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <!-- 一键单选此项（彻底解决必须一个个取消其它项的烦恼） -->
                                <Button Content="仅选此项" Click="SelectOnlyThis_Click" 
                                        ToolTipService.ToolTip="取消其它所有勾选，仅单独保留勾选此项"
                                        Padding="10,5" FontSize="12"/>

                                <!-- 容量与扫描状态 -->
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3" MinWidth="95">
                                    <TextBlock Text="{Binding SizeDisplay}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" HorizontalAlignment="Right" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 子项目明细列表 (展开时展示) -->
                        <Border Visibility="{Binding ExpandedVisibility}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="36,4,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="已发现项目明细 (取消勾选即可保留对应项目 target/依赖，免除重复编译或重装):" 
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding SubItemRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeHuman}" FontWeight="SemiBold" FontSize="12" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                                <Button Grid.Column="3" Content="定位" Padding="8,2" FontSize="11" 
                                                        Click="OpenFolder_Click" Tag="{Binding Path}" ToolTipService.ToolTip="在文件资源管理器中打开此目录"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部汇总与执行操作栏 -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="已扫描勾选可释放:" FontSize="14"/>
                        <TextBlock x:Name="TotalSizeText" Text="0 B" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock x:Name="TotalFilesText" Text="" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="临时缓存建议【直接永久清理】（极速且不塞爆回收站）；代码依赖推荐【移入回收站】" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="ApplyRecycleButton" Content="移入回收站 (可撤销)" 
                            Click="ApplyRecycleButton_Click" Padding="14,10"/>
                    <Button x:Name="ApplyPermanentButton" Content="直接永久清理 (极速模式)" 
                            Click="ApplyPermanentButton_Click" Style="{ThemeResource AccentButtonStyle}" Padding="16,10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>