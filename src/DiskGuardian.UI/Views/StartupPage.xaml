<Page
    x:Class="DiskGuardian.UI.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:diag="using:DiskGuardian.Core.Diagnostics"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="启动项治理中心 (StartupDoctor)" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="SummaryText" Text="整合 8 维开机自启、后台服务、计划任务与底层 Winsock/AppInit/角标扫描，受保护核心项绝不误杀"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="RefreshBtn" Content="🔄 重新扫描" Style="{ThemeResource AccentButtonStyle}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- 4 宫格概览 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="常规自启 &amp; 任务" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="RegTaskCountText" Text="--" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RegTaskSubText" Text="注册表/文件夹/计划任务" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="第三方自动服务" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ServiceCountText" Text="--" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Start=Auto 非系统路径" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="建议可优化冗余" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="OptimizableCountText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Text="支持无损禁用与随时恢复" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="底层注入 &amp; 图标角标" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="LowLevelCountText" Text="--" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LowLevelSubText" Text="NSP / AppInit / Shell角标" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 分类筛选与搜索 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="CatAllBtn" Content="全部" IsChecked="True" Click="CategoryBtn_Click" Tag="All"/>
                <ToggleButton x:Name="CatRegBtn" Content="🔑 自启与文件夹" Click="CategoryBtn_Click" Tag="Reg"/>
                <ToggleButton x:Name="CatSvcBtn" Content="⚙️ 自动服务" Click="CategoryBtn_Click" Tag="Svc"/>
                <ToggleButton x:Name="CatTaskBtn" Content="⏰ 计划任务" Click="CategoryBtn_Click" Tag="Task"/>
                <ToggleButton x:Name="CatLowBtn" Content="🌐 底层注入与角标" Click="CategoryBtn_Click" Tag="Low"/>
                <ToggleButton x:Name="CatOptBtn" Content="💡 仅看可优化" Click="CategoryBtn_Click" Tag="Opt"/>
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索名称或路径..." TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- 列表 -->
        <ListView x:Name="StartupListView" Grid.Row="3" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="diag:StartupItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind CategoryDisplay}" FontSize="11"/>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind RiskDisplay}" FontSize="11"/>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind StatusDisplay}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Command}" FontFamily="Consolas, Segoe UI" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Reason}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="切换启用/禁用" IsEnabled="{x:Bind CanToggle}"
                                        Tag="{x:Bind}" Click="ToggleItemBtn_Click"
                                        ToolTipService.ToolTip="核心保护项禁止禁用；可优化项支持无损禁用与恢复"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
