<Window
    x:Class="DiskGuardian.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="disk-guardian (WinUI 3 Fluent)">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义 Fluent 标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Margin="16,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                <TextBlock Text="disk-guardian" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="Windows 11 Native" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 核心导航容器 -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="仪表盘与体检" Tag="dashboard" Icon="Home"/>
                <NavigationViewItem Content="空间规则清理" Tag="cleaner" Icon="Delete"/>
                <NavigationViewItem Content="回收站安全管理" Tag="recycle" Icon="Trash"/>
                <NavigationViewItem Content="审计流水日志" Tag="audit" Icon="Document"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="16,8,24,16"/>
        </NavigationView>
    </Grid>
</Window>
